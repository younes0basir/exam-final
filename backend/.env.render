# Production Environment Configuration for Render.com
# Copy these values to Render Dashboard → Environment tab

# Application
APP_NAME=UPF University
APP_ENV=production
APP_KEY=base64:qQWArZb06HGtFdvH7eo17F5xw1IMYfYCcfcX3qJtofE=
APP_DEBUG=false
APP_URL=https://upf-manage.onrender.com

# Locale
APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

# Maintenance
APP_MAINTENANCE_DRIVER=file

# Security
BCRYPT_ROUNDS=12

# Logging (stderr for Docker/Render)
LOG_CHANNEL=stderr
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# Database (Railway)
DB_CONNECTION=mysql
DB_HOST=switchback.proxy.rlwy.net
DB_PORT=26711
DB_DATABASE=railway
DB_USERNAME=root
DB_PASSWORD=cXFCHdBFAdkihIIbbmceLzQoXUFEtxTt

# Session
SESSION_DRIVER=cookie
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=.onrender.com

# Broadcast
BROADCAST_CONNECTION=log

# Filesystem
FILESYSTEM_DISK=local

# Queue
QUEUE_CONNECTION=sync

# Cache
CACHE_STORE=file

# Mail
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@upf-manage.onrender.com"
MAIL_FROM_NAME="${APP_NAME}"

# AWS (if needed)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Vite
VITE_APP_NAME="${APP_NAME}"

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,https://upf-manage.onrender.com

# Sanctum Configuration
SANCTUM_STATEFUL_DOMAINS=localhost:3000,localhost:5173,upf-manage.onrender.com

# Redis (not used in production)
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
